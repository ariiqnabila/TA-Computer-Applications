      20.51 
>equ &= fs(K,R,P,n)=Kn; $&equ
 %image% Tugas 2-106.png
% // latex: K\,\left(1+\frac{P}{100}\right)^{n}+\frac{100\,\left(-1+\left(1+  \frac{P}{100}\right)^{n}\right)\,R}{P}={\it Kn}
>equ &= (equ with P=100*i); $&equ
 %image% Tugas 2-107.png
% // latex: \left(1+i\right)^{n}\,K+\frac{\left(-1+\left(1+i\right)^{n}\right)  \,R}{i}={\it Kn}
>$&solve(equ,R)
 %image% Tugas 2-108.png
% // latex: \left[ R=\frac{i\,{\it Kn}-i\,\left(1+i\right)^{n}\,K}{-1+\left(1+i  \right)^{n}} \right] 
