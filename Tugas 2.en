>fn &= solve(equ,n) | ratsimp; $&fn
 %image% Tugas 2-110.png
% // latex: \left[ n=\frac{\log \left(i\,{\it Kn}+R\right)-\log \left(i\,K+R  \right)}{\log \left(1+i\right)} \right] 
% ** Merangkum Operasi Aljabar Standar
% 
% $expand(ekspresi) : Mengekspansi persamaan.
%% $factor(ekspresi) : Memfaktorkan persamaan persekutuan/kuadratik.
%% $ratsimp(ekspresi) : Mensimplifikasi pecahan silang berbelit.
% 
>$expand((x+y)^3)
 %image% Tugas 2-111.png
% // latex: x^3+3\,x^2\,y+3\,x\,y^2+y^3
% Ekspansi bentuk (x+y)^3 dijabarkan menjadi deret binomial utuh.
>$factor(x^3 - 6*x^2 + 11*x - 6)
 %image% Tugas 2-112.png
% // latex: \left(-3+x\right)\,\left(-2+x\right)\,\left(-1+x\right)
% Polinomial tingkat tinggi yang nampak acak langsung diekstrak akar akarnya.
>$ratsimp((x^2 - 1) / (x - 1))
 %image% Tugas 2-113.png
% // latex: 1+x
% Fraksional rasional direduksi memotong pembilang vs penyebut sejenis.
% 
% ** Kalkulus Fundamental (Limit, Turunan, Integral)
% 
>$limit((2*x^2 - 5) / (3*x^2 + x), x, inf)
 %image% Tugas 2-114.png
% // latex: \frac{2}{3}
% Perhitungan fungsi pergerakan asimtotik asimtot dipecahkan pada ambang tidak terbatas limit inf.
>$diff(sin(x)*cos(x), x)
 %image% Tugas 2-115.png
% // latex: \cos ^2x-\sin ^2x
% Turunan persamaan kalkulus kompleks diselesaikan mengikuti aturan produk bersarang (product rule).
