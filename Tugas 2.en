% Mengekspansi domain sejati pertidaksamaan silang linier ke kuadratik menggunakan eliminasi Fourier.
%% latex: 61. \quad 2y-3\ge 1-y+5
% %image% Tugas 2-309.png
% // latex: 61. \quad 2y-3\ge 1-y+5
>$fourier_elim([2*y-3>=1-y+5],[y])
 %image% Tugas 2-310.png
% // latex: \left[ y=3 \right] \lor \left[ 3<y \right] 
% 
% latex: 62. \quad (x-2)(x+5)>x(x-3)
% %image% Tugas 2-311.png
% // latex: 62. \quad (x-2)(x+5)>x(x-3)
>$fourier_elim([(x-2)*(x+5)>x*(x-3)],[x])
 %image% Tugas 2-312.png
% // latex: \left[ \frac{5}{3}<x \right] 
% Set Latihan 4.3
% 
% Pembuktian sisa faktorial bagi habis.
%% latex: 3. \quad g(x)=x^3-2x^2-11x+12
% %image% Tugas 2-313.png
% // latex: 3. \quad g(x)=x^3-2x^2-11x+12
>$factor(x^3-2*x^2-11*x+12)
 %image% Tugas 2-314.png
% // latex: \left(-4+x\right)\,\left(-1+x\right)\,\left(3+x\right)
% Jelas bahwa hanya (x-4) dan (x-1) yang merupakan faktor bagi genap dari kelompok fungsi g.
% 
% Merinci hasil bagi beserta sisanya:
%% latex: 19. \quad (x^4-1)\div (x-1)
% %image% Tugas 2-315.png
% // latex: 19. \quad (x^4-1)\div (x-1)
>$factor(x^4-1)
 %image% Tugas 2-316.png
% // latex: \left(-1+x\right)\,\left(1+x\right)\,\left(1+x^2\right)
% Membuktikan bahwa hasil reduksinya mencapai rentang:
%% latex: (x^2+1)(x+1)
% %image% Tugas 2-317.png
% // latex: (x^2+1)(x+1)
%% yang berakhir sisa modulus eksak bernilai 0.
% 
% 30. Substitusi berantai dan eksekusi plot2d untuk membangkitkan grafik di kanvas bidang rasional
% (Cartesius).
%% latex: f(x)=x^5
% %image% Tugas 2-318.png
% // latex: f(x)=x^5
>&kill(f); function f(x)&=x^5;
>f(2)
      32.00 
>f(-2)
     -32.00 
>f(3)
     243.00 
>&f(2+3*%i)

                                                      5
                                             (2 + 3 I)

>plot2d("f(x)",-3,3):
 %image% Tugas 2-319.png
% 
% latex: 54. \quad -x^4+2x^3+3x^2-4x-4
% %image% Tugas 2-320.png
% // latex: 54. \quad -x^4+2x^3+3x^2-4x-4
>&kill(f); function f(x)&=-x^4+2*x^3+3*x^2-4*x-4; plot2d("f(x)",-5,5):
 %image% Tugas 2-321.png
% 
% Mengoperasikan pembagian panjang bersarang yang mencakup besaran domain Imajiner (i).
%% latex: 71. \quad (x^3+3ix^2-4ix-2)\div(x+i)
% %image% Tugas 2-322.png
% // latex: 71. \quad (x^3+3ix^2-4ix-2)\div(x+i)
>&divide(x^3+3*%i*x^2-4*%i*x-2, x+%i, x)

                                                      2
                                  [2 - 4 I + 2 I x + x , - 6 - 2 I]

% divide(f(x), g(x), x) mengembalikan kombinasi dua ruas bertipe [hasil hitung sejati, modulus (sisa)
% bagi] secara konsisten. Jadi, hasil baginya adalah
%% latex: x^2+2ix-4i+2
% %image% Tugas 2-323.png
% // latex: x^2+2ix-4i+2
%% dan sisanya adalah -6 -2i.
>
