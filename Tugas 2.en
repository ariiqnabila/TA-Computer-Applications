>
% Sederhanakan bentuk pangkat pecahan silang:
%% latex: 49. \left(\frac{24a^{10}b^{-8}c^7}{12a^6b^{-3}c^5}\right)^{-5}
% %image% Tugas 2-183.png
% // latex: 49. \left(\frac{24a^{10}b^{-8}c^7}{12a^6b^{-3}c^5}\right)^{-5}
>$ ratsimp(((24*a^10*b^(-8)*c^7)/(12*a^6*b^(-3)*c^5))^(-5))
 %image% Tugas 2-184.png
% // latex: \frac{b^{25}}{32\,a^{20}\,c^{10}}
% Melalui penerapan peranti ratsimp() bersama eksekusi flag $, pecahan polinomial tingkat ekstrem
% berhasil diringkas tanpa melanggar tatanan kaidah aljabar.
% 
% latex: 50.\left(\frac{125p^{12}q^{-14}r^{22}}{25p^{8}q^{6}r^{-15}}\right)^{-4}
% %image% Tugas 2-185.png
% // latex: 50.\left(\frac{125p^{12}q^{-14}r^{22}}{25p^{8}q^{6}r^{-15}}\right)^{-4}
>$ ratsimp(((125*p^12*q^(-14)*r^22)/(25*p^8*q^6*r^(-15)))^(-4))
 %image% Tugas 2-186.png
% // latex: \frac{q^{80}}{625\,p^{16}\,r^{148}}
% 
% Hitung operasi pangkat linier berurutan:
%% latex: 90. \quad 2^6 \cdot 2^{-3} \div 2^{10} \div 2^{-8}
% %image% Tugas 2-187.png
% // latex: 90. \quad 2^6 \cdot 2^{-3} \div 2^{10} \div 2^{-8}
>2^6*2^(-3)/2^10/2^(-8)
       2.00 
% Karena barisan logika aritmatika di soal nomor 90 hanya meminta operasi skalar numerik secara utuh,
% tanda awalan $ menjadi tidak relevan, kalkulasi berjalan otomatis secara akurat.
% 
% latex: 91. \quad \frac{4(8-6)^2-4\cdot3+2\cdot8}{3^1+19^0}
% %image% Tugas 2-188.png
% // latex: 91. \quad \frac{4(8-6)^2-4\cdot3+2\cdot8}{3^1+19^0}
>(4*(8-6)^2-4*3+2*8)/(3^1+19^0)
       5.00 
% 
% Sederhanakan perkalian basis variabel berpangkat polinom:
%% latex: 104. \quad (m^{x-b}\cdot n^{x+b})^{x}(m^{b}n^{-b})^{x}
% %image% Tugas 2-189.png
% // latex: 104. \quad (m^{x-b}\cdot n^{x+b})^{x}(m^{b}n^{-b})^{x}
>$ radcan((m^(x-b)*n^(x+b))^(x)*(m^b*n^(-b))^(x))
 %image% Tugas 2-190.png
% // latex: m^{x^2}\,n^{x^2}
% Ketika perintah rasional biasa ratsimp() membentur batasan limit simplifikasi pangkat bertumpuk, opsi
% tingkat lebih lanjut yakni radcan() dipanggil guna me-reduksi komplikasi akar/pangkat.
% 
% latex: 106. \quad \left[\left(\frac{x^r}{y^t}\right)^2 \left(\frac{x^{2r}}{y^{4t}}\right)^{-2}\right]^{-3}
% %image% Tugas 2-191.png
% // latex: 106. \quad \left[\left(\frac{x^r}{y^t}\right)^2 \left(\frac{x^{2r}}{y^{4t}}\right)^{-2}\right]^{-3}
>$ radcan(((x^r/y^t)^2*(x^(2*r)/y^(4*t))^(-2))^(-3))
 %image% Tugas 2-192.png
% // latex: \frac{x^{6\,r}}{y^{18\,t}}
