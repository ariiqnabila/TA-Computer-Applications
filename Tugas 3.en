% // latex: f(x)=sin(x)cos(x)
>function f(x):=sin(x)*cos(x)
>plot2d("f",-pi,pi):
 %image% Tugas 3-178.png
% ** Grafik Fungsi Satu Variabel yang Fungsinya Didefinisikan sebagai Fungsi Simbolik
% 
% latex: f(x)=x^3-3x
% %image% Tugas 3-179.png
% // latex: f(x)=x^3-3x
>function f(x)&=x^3-3*x;
>plot2d("f",-3,3):
 %image% Tugas 3-180.png
% latex: \frac{dy}{dx}, y=sin(x)e^x
% %image% Tugas 3-181.png
% // latex: \frac{dy}{dx}, y=sin(x)e^x
>plot2d(&diff(sin(x)*exp(x),x),-pi,pi):
 %image% Tugas 3-182.png
% ** Grafik Beberapa Kurva Sekaligus
% 
% latex: y=x^2,y=x^3,y=x^4
% %image% Tugas 3-183.png
% // latex: y=x^2,y=x^3,y=x^4
>plot2d(["x^2","x^3","x^4"],-2,2):
 %image% Tugas 3-184.png
% latex: y=sin(x),y=cos(x)
% %image% Tugas 3-185.png
% // latex: y=sin(x),y=cos(x)
>x=linspace(-2,2,100);
>plot2d(x,[sin(x);cos(x)]):
 %image% Tugas 3-186.png
% ** Grafik Beberapa Kurva dalam Satu Bidang Koordinat
% 
% latex: y=x^2,y=x^3
% %image% Tugas 3-187.png
% // latex: y=x^2,y=x^3
>plot2d("x^2",-2,2);
>plot2d("x^3",-2,2,>add):
 %image% Tugas 3-188.png
% latex: y=x^2, scatter (titik sebar)
% %image% Tugas 3-189.png
% // latex: y=x^2, scatter (titik sebar)
>plot2d(1:10,(1:10)^2+random(1,10),>points);
>plot2d("x^2",1,10,>add):
 %image% Tugas 3-190.png
% ** Label Sumbu Koordinat, Label Kurva, dan Keterangan Kurva (Legend)
% 
% latex: y=sin(x)
% %image% Tugas 3-191.png
% // latex: y=sin(x)
% 
% dengan keterangan sumbu x sebagai waktu, sumbu y sebagai amplitudo, dan judul, yaitu gelombang sinus.
>plot2d("sin(x)",0,2*pi,xl="waktu(t)",yl="amplitudo",title="gelombang sinus"):
 %image% Tugas 3-192.png
% latex: y=x^2
% %image% Tugas 3-193.png
% // latex: y=x^2
