% * Materi Lainnya
% - Ukuran statistika deskriptif tambahan (jangkauan, modus, dan metode   pergeseran nilai taksiran), -
% Uji kesesuaian distribusi normal dengan kertas probabilitas normal, - Interval kepercayaan untuk
% rata-rata dan varians, - Uji independensi korelasi dan interval kepercayaan koefisien regresi, -
% Regresi linear multidimensi (berganda) dan uji ekuivalensi, - Algoritma pembangkit bilangan acak dan
% transformasi invers, - Aplikasi metode Monte Carlo untuk integral lipat dan persamaan   diferensial
% parsial (masalah nilai batas Laplace).
% 
% * Ukuran Statistika Deskriptif Tambahan
% 
% Selain rata-rata, median, dan simpangan baku, ukuran deskriptif lain yang sering digunakan adalah
% jangkauan (range) dan modus. Jangkauan R didefinisikan sebagai selisih antara nilai maksimum dan
% minimum:
% 
% latex: R = x_{\max} - x_{\min}.
% %image% Tugas 7-051.png
% // latex: R = x_{\max} - x_{\min}.
% 
% Sedangkan modus adalah nilai data yang muncul dengan frekuensi paling besar. Berikut adalah contoh
% pengukuran induksi celah udara pada 15 pengeras suara (dalam satuan Tesla).
>x = [1.01, 1.02, 1.00, 0.98, 0.99, 1.00, 0.99, 1.01, ...
>     1.01, 1.00, 1.00, 1.00, 1.02, 1.00, 1.01];
% Kita dapat menghitung rata-rata, varians sampel s^2, median, serta jangkauan R dari sampel tersebut.
>xbar = mean(x), s2 = dev(x)^2, med = median(x), R = max(x) - min(x),
1.0027
0.00012095
1
0.04
% Untuk mencari modus, kita menghitung multiplisitas setiap nilai unik dalam sampel menggunakan fungsi
% unique() dan getmultiplicities().
>u = unique(x); freq = getmultiplicities(u, x);
>modus = u[nonzeros(freq == max(freq))]
1
% Untuk bilangan dengan banyak digit yang hanya berbeda pada beberapa digit terakhir, perhitungan
% rata-rata dan varians dapat disederhanakan menggunakan nilai taksiran awal x_0 melalui transformasi
% 
% latex: z_i = x_i - x_0
% %image% Tugas 7-052.png
% // latex: z_i = x_i - x_0
% 
% latex: \bar{x} = x_0 + \bar{z}, \qquad s^2 = \frac{\sum_{i=1}^n z_i^2 - n(\bar{x}-x_0)^2}{n-1}.
% %image% Tugas 7-053.png
% // latex: \bar{x} = x_0 + \bar{z}, \qquad s^2 = \frac{\sum_{i=1}^n z_i^2 - n(\bar{x}-x_0)^2}{n-1}.
% 
% Mari kita terapkan metode ini dengan memilih
% 
% latex: x_0 = 1.00.
% %image% Tugas 7-054.png
% // latex: x_0 = 1.00.
>x0 = 1.00; z = x - x0; n = length(x);
>xbarkode = x0 + mean(z)
1.0027
>s2kode = (sum(z^2) - n*(xbarkode - x0)^2) / (n - 1)
0.00012095
% * Uji Kesesuaian dengan Kertas Probabilitas Normal
% 
% Untuk memeriksa secara grafis apakah data sampel berasal dari distribusi normal, kita dapat
% menggunakan prinsip kertas probabilitas normal (normal probability paper). Jika
% 
% latex: X \sim N(\mu, \sigma^2)
% %image% Tugas 7-055.png
% // latex: X \sim N(\mu, \sigma^2)
% 
% , maka fungsi distribusi kumulatifnya memenuhi hubungan linear:
% 
% latex: z = \Phi^{-1}(F(x)) = \frac{x - \mu}{\sigma}.
% %image% Tugas 7-056.png
% // latex: z = \Phi^{-1}(F(x)) = \frac{x - \mu}{\sigma}.
% 
% Dengan demikian, jika frekuensi kumulatif relatif F_j ditransformasikan melalui invers distribusi
% normal standar
% 
% latex: \Phi^{-1}(F_j)
% %image% Tugas 7-057.png
% // latex: \Phi^{-1}(F_j)
% 
% dan diplot terhadap batas atas kelas
% 
% latex: \xi_j,
% %image% Tugas 7-058.png
% // latex: \xi_j,
% 
% titik-titik tersebut akan terletak mendekati sebuah garis lurus.
% 
% Berikut adalah data n = 125 pengukuran yang dikelompokkan ke dalam 11 kelas dari 50 hingga 270 dengan
% lebar kelas h = 20.
>xi = 70:20:270; // batas atas setiap kelas
>h = [1, 1, 2, 9, 15, 22, 30, 27, 9, 6, 3]; // frekuensi absolut
>F = cumsum(h) / sum(h); // frekuensi kumulatif relatif
% Karena 
% 
% latex: \Phi^{-1}(1) = \infty, 
% %image% Tugas 7-059.png
% // latex: \Phi^{-1}(1) = \infty, 
% 
% kita memplot 10 batas atas kelas pertama terhadap nilai 
% 
% latex: z_j = \Phi^{-1}(F_j) 
% %image% Tugas 7-060.png
% // latex: z_j = \Phi^{-1}(F_j) 
% 
% menggunakan fungsi invnormaldis().
>z = invnormaldis(F[1:10], 0, 1);
>p = polyfit(xi[1:10], z, 1); // pencocokan garis lurus z = p[1] + p[2]*x
>plot2d(xi[1:10], z, >points, style="x", color=red, ...
>  xl="Batas Atas Kelas", yl="z = invnormaldis(F)"); ...
>plot2d("evalpoly(x,p)", 60, 260, color=blue, >add):
 %image% Tugas 7-061.png
% Dari kemiringan dan titik potong garis lurus
% 
% latex: z = -\mu/\sigma + (1/\sigma)x,
% %image% Tugas 7-062.png
% // latex: z = -\mu/\sigma + (1/\sigma)x,
% 
% kita dapat menaksir parameter \mu dan \sigma secara langsung.
>sigmaest = 1 / p[2], muest = -p[1] / p[2],
38.986
174.88
% * Interval Kepercayaan untuk Rata-Rata dan Varians
% 
% ** 1. Interval Kepercayaan Rata-Rata (Varians Populasi \sigma^2 Diketahui)
% 
% Jika sampel acak berukuran n diambil dari populasi dengan varians \sigma^2 yang diketahui dan tingkat
% signifikansi \alpha, batas kepercayaan untuk nilai harapan \mu adalah:
% 
% latex: \bar{x} \pm \frac{\sigma}{\sqrt{n}} z_{1-\alpha/2}.
% %image% Tugas 7-063.png
% // latex: \bar{x} \pm \frac{\sigma}{\sqrt{n}} z_{1-\alpha/2}.
% 
% Berikut adalah fungsi untuk menghitung interval kepercayaan tersebut.
>function cimeanknown (x, sigma, alpha=0.05) ...
$  n = length(x);
$  zcrit = invnormaldis(1 - alpha/2, 0, 1);
$  err = zcrit * sigma / sqrt(n);
$  return [mean(x) - err, mean(x) + err];
$endfunction
>cimeanknown([0.842, 0.846, 0.835, 0.839, 0.843, 0.838], 0.004, 0.05)
[0.8373,  0.8437]
% ** 2. Interval Kepercayaan Rata-Rata (Varians Populasi \sigma^2 Tidak Diketahui)
% 
% Jika populasi berdistribusi normal dan \sigma^2 tidak diketahui, kita menggantinya dengan simpangan
% baku sampel s dan menggunakan kuantil distribusi-t dengan derajat kebebasan m = n - 1:
% 
% latex: \bar{x} \pm \frac{s}{\sqrt{n}} t_{1-\alpha/2; \, n-1}.
% %image% Tugas 7-064.png
% // latex: \bar{x} \pm \frac{s}{\sqrt{n}} t_{1-\alpha/2; \, n-1}.
% 
% Mari kita terapkan pada sampel 6 hasil pengukuran dengan tingkat signifikansi 
% 
% latex: \alpha = 5\% \text{ dan } \alpha = 1\%.
% %image% Tugas 7-065.png
% // latex: \alpha = 5\% \text{ dan } \alpha = 1\%.
>function cimeanunknown (x, alpha=0.05) ...
$  n = length(x);
$  tcrit = invtdis(1 - alpha/2, n - 1);
$  err = tcrit * dev(x) / sqrt(n);
$  return [mean(x) - err, mean(x) + err];
$endfunction
>sampel = [0.842, 0.846, 0.835, 0.839, 0.843, 0.838];
>mean(sampel), dev(sampel),
0.8405
0.003937
>cimeanunknown(sampel, 0.05) // tingkat kepercayaan 95%
[0.83637,  0.84463]
>cimeanunknown(sampel, 0.01) // tingkat kepercayaan 99%
[0.83402,  0.84698]
% ** 3. Interval Kepercayaan untuk Varians \sigma^2
% 
% Untuk populasi berdistribusi normal, besaran 
% 
% latex: (n-1)s^2/\sigma^2 
% %image% Tugas 7-066.png
% // latex: (n-1)s^2/\sigma^2 
% 
% mengikuti distribusi \chi^2 dengan derajat kebebasan m = n - 1. Interval kepercayaan (1-\alpha) untuk
% \sigma^2 diberikan oleh:
% 
% latex: \frac{(n-1)s^2}{\chi^2_{1-\alpha/2; \, n-1}} \le \sigma^2 \le \frac{(n-1)s^2}{\chi^2_{\alpha/2; \, n-1}}.
% %image% Tugas 7-067.png
% // latex: \frac{(n-1)s^2}{\chi^2_{1-\alpha/2; \, n-1}} \le \sigma^2 \le \frac{(n-1)s^2}{\chi^2_{\alpha/2; \, n-1}}.
>function civar (x, alpha=0.05) ...
$  n = length(x);
$  s2 = dev(x)^2;
$  chilower = invchidis(alpha/2, n - 1);
$  chiupper = invchidis(1 - alpha/2, n - 1);
$  return [(n - 1)*s2 / chiupper, (n - 1)*s2 / chilower];
$endfunction
>civar(sampel, 0.05) // interval kepercayaan 95% untuk varians
[0,  9.3237e-05]
>sqrt(civar(sampel, 0.05)) // interval kepercayaan 95% untuk simpangan baku
[0.0024575,  0.009656]
% * Uji Independensi Korelasi dan Interval Koefisien Regresi
% 
% ** 1. Uji Independensi Dua Variabel (H_0: \rho_{XY} = 0)
% 
% Untuk menguji apakah dua variabel X dan Y yang berdistribusi normal bivariat saling independen
% 
% latex: (\rho{XY} = 0),
% %image% Tugas 7-068.png
% // latex: (\rho{XY} = 0),
% 
% kita menghitung statistik uji t dari koefisien korelasi empiris
% 
% latex: r_{xy}
% %image% Tugas 7-069.png
% // latex: r_{xy}
% 
% latex: t = \frac{r_{xy}\sqrt{n-2}}{\sqrt{1 - r{xy}^2}},
% %image% Tugas 7-070.png
% // latex: t = \frac{r_{xy}\sqrt{n-2}}{\sqrt{1 - r{xy}^2}},
% 
% yang berdistribusi-t dengan derajat kebebasan m = n - 2.
>function correltest (x, y) ...
$  n = length(x);
$  r = correl(x, y);
$  tstat = r * sqrt(n - 2) / sqrt(1 - r^2);
$  pval = 2 * (1 - tdis(abs(tstat), n - 2));
$  return {r, tstat, pval};
$endfunction
>x = 1:10; y = [2, 3, 1, 5, 6, 3, 7, 8, 9, 8];
>{r, tstat, pval} = correltest(x, y);
>r, tstat, pval,
0.87175
5.0325
0.001011
% Karena nilai-p jauh lebih kecil dari 0.05, hipotesis nol bahwa X dan Y tidak berkorelasi ditolak.
% 
% ** 2. Interval Kepercayaan untuk Koefisien Regresi Linear
% 
% Pada garis regresi
% 
% latex: y(x) = \tilde{a} + \tilde{b}x,
% %image% Tugas 7-071.png
% // latex: y(x) = \tilde{a} + \tilde{b}x,
% 
% batas kepercayaan (1-\alpha) untuk kemiringan \tilde{b} dan titik potong \tilde{a}$masing-masing
% dihitung dengan
% 
% latex: \tilde{b} \pm t_{1-\alpha/2; \, n-2} \frac{s_y \sqrt{1 - r_{xy}^2}}{s_x \sqrt{n-2}}, \qquad \tilde{a} \pm t_{1-\alpha/2; \, n-2} \frac{s_y \sqrt{1 - r_{xy}^2} \sqrt{\sum x_i^2}}{s_x \sqrt{n-2} \sqrt{n}}.
% %image% Tugas 7-072.png
% // latex: \tilde{b} \pm t_{1-\alpha/2; \, n-2} \frac{s_y \sqrt{1 - r_{xy}^2}}{s_x \sqrt{n-2}}, \qquad \tilde{a} \pm t_{1-\alpha/2; \, n-2} \frac{s_y \sqrt{1 - r_{xy}^2} \sqrt{\sum x_i^2}}{s_x \sqrt{n-2} \sqrt{n}}.
>function cireg (x, y, alpha=0.05) ...
$  n = length(x);
$  p = polyfit(x, y, 1); // p[1] = a, p[2] = b
$  r = correl(x, y);
$  sx = dev(x); sy = dev(y);
$  tcrit = invtdis(1 - alpha/2, n - 2);
$  sefactor = sy * sqrt(1 - r^2) / (sx * sqrt(n - 2));
$  errb = tcrit * sefactor;
$  erra = tcrit * sefactor * sqrt(sum(x^2) / n);
$  return [p[1] - erra, p[1] + erra; p[2] - errb, p[2] + errb];
$endfunction
>cireg(x, y, 0.05) // baris 1: interval untuk a, baris 2: interval untuk b
  -1.5757    3.0424 
  0.43999    1.1843 
% * Regresi Multidimensi (Berganda)
% 
% Jika variabel tak bebas Y bergantung secara linear pada beberapa fungsi basis 
% 
% latex: g_j(\underline{x}), 
% %image% Tugas 7-073.png
% // latex: g_j(\underline{x}), 
% 
% model regresinya ditulis sebagai
% 
% latex: y = \sum_{j=0}^s a_j g_j(\underline{x}).
% %image% Tugas 7-074.png
% // latex: y = \sum_{j=0}^s a_j g_j(\underline{x}).
% 
% Dengan metode kuadrat terkecil, vektor taksiran koefisien 
% 
% latex: \tilde{\underline{a}} 
% %image% Tugas 7-075.png
% // latex: \tilde{\underline{a}} 
% 
% diperoleh dengan menyelesaikan sistem persamaan normal:
% 
% latex: G^T G \tilde{\underline{a}} = G^T \underline{f}.
% %image% Tugas 7-076.png
% // latex: G^T G \tilde{\underline{a}} = G^T \underline{f}.
% 
% Mari kita selesaikan contoh model
% 
% latex: \tilde{f}(x_1, x_2) = a_0 + a_1 x_1 + a_2 x_2
% %image% Tugas 7-077.png
% // latex: \tilde{f}(x_1, x_2) = a_0 + a_1 x_1 + a_2 x_2
% 
% untuk 4 titik pengamatan.
>x1 = [5, 3, 5, 3]';
>x2 = [0.5, 0.5, 0.3, 0.3]';
>f = [1.5, 3.5, 6.2, 3.2]';
>G = ones(4, 1) | x1 | x2
        1         5       0.5 
        1         3       0.5 
        1         5       0.3 
        1         3       0.3 
% Kita menyusun matriks persamaan normal
% 
% latex: G^T G \quad \text{dan vektor sisi kanan}
% %image% Tugas 7-078.png
% // latex: G^T G \quad \text{dan vektor sisi kanan}
% 
% latex: G^T \underline{f},
% %image% Tugas 7-079.png
% // latex: G^T \underline{f},
% 
% lalu menyelesaikannya menggunakan operator \.
>ahat = (G'.G) \ (G'.f)
        7 
     0.25 
      -11 
% Hasilnya adalah
% 
% latex: \tilde{a}_0 = 7.0, \quad \tilde{a}_1 = 0.25, \quad \text{dan} \quad \tilde{a}_2 = -11.0.
% %image% Tugas 7-080.png
% // latex: \tilde{a}_0 = 7.0, \quad \tilde{a}_1 = 0.25, \quad \text{dan} \quad \tilde{a}_2 = -11.0.
% 
% Kita juga dapat menghitung jumlah kuadrat sisaan (residual sum of squares) serta melakukan uji
% ekuivalensi dengan distribusi-F untuk membandingkan model penuh dengan model tereduksi.
>resfull = f - G.ahat;
>SSRfull = sum((resfull^2)')
6.25
% Misalkan kita ingin menguji apakah koefisien a_2 dapat diabaikan (H_0: a_2 = 0), sehingga model
% tereduksi hanya menggunakan x_1.
>Gred = ones(4, 1) | x1;
>ared = (Gred'.Gred) \ (Gred'.f);
>resred=f-Gred.ared;
>SSRred = sum(((resred)^2)');
>df1 = cols(G) - cols(Gred); // selisih jumlah parameter = 1
>df2 = rows(G) - cols(G); // derajat kebebasan sisaan = 4 - 3 = 1
>Fstat = ((SSRred - SSRfull) / df1) / (SSRfull / df2)
0.7744
>pvalF = 1 - fdis(Fstat, df1, df2)
0.54058
% Karena nilai-p lebih besar dari 0.05, penghapusan variabel x_2 tidak memperburuk kecocokan model
% secara signifikan pada sampel kecil ini.
% 
% * Algoritma Pembangkit Bilangan Acak
% 
% ** 1. Metode Kuadrat Tengah (J. von Neumann)
% 
% Metode ini dimulai dari bilangan desimal 
% 
% latex: z_0 \in (0, 1) 
% %image% Tugas 7-081.png
% // latex: z_0 \in (0, 1) 
% 
% dengan 2n digit, mengkuadratkannya sehingga menghasilkan 4n digit, lalu mengambil 2n digit di bagian
% tengah sebagai bilangan acak berikutnya.
>function midsquare (z0, k, ndigits=4) ...
$  res = zeros(1, k);
$  z = z0;
$  half = ndigits / 2;
$  for i = 1 to k;
$    res[i] = z;
$    val = floor(z^2 * 10^(ndigits + half));
$    z = mod(val, 10^ndigits) / 10^ndigits;
$  end;
$  return res;
$endfunction
>midsquare(0.1234, 6, 4)
[0.1234,  0.5227,  0.3215,  0.3362,  0.303,  0.1809]
% Metode ini jarang digunakan dalam praktik modern karena deretnya dapat mengalami degenerasi menuju
% nol.
% 
% ** 2. Metode Kongruensi Linear (Linear Congruential Generator)
% 
% Metode yang jauh lebih luas digunakan adalah rekursi kongruensi:
% 
% latex: z_{i+1} \equiv c \cdot z_i \pmod{m}, \qquad u_i = \frac{z_i}{m}.
% %image% Tugas 7-082.png
% // latex: z_{i+1} \equiv c \cdot z_i \pmod{m}, \qquad u_i = \frac{z_i}{m}.
>function lcg (z0, c, m, k) ...
$  u = zeros(1, k);
$  z = z0;
$  for i = 1 to k;
$    z = mod(c * z, m);
$    u[i] = z / m;
$  end;
$  return u;
$endfunction
>lcg(123, 16807, 2^31 - 1, 8)
[0.00096264,  0.17915,  0.93945,  0.41397,  0.53037,  0.93198,  0.78649,  0.50036]
% ** 3. Metode Transformasi Invers
% 
% latex: (F^{-1}(\xi))
% %image% Tugas 7-083.png
% // latex: (F^{-1}(\xi))
% 
% Jika
% 
% latex: \xi \sim U(0, 1)
% %image% Tugas 7-084.png
% // latex: \xi \sim U(0, 1)
% 
% adalah bilangan acak berdistribusi seragam dan F(x) adalah fungsi distribusi kumulatif kontinu yang
% memiliki invers, maka
% 
% latex: \eta = F^{-1}(\xi) \quad \text{mengikuti distribusi $F(x)$}.
% %image% Tugas 7-085.png
% // latex: \eta = F^{-1}(\xi) \quad \text{mengikuti distribusi $F(x)$}.
% 
% Sebagai contoh, untuk distribusi eksponensial
% 
% latex: F(x) = 1 - e^{-\lambda x},
% %image% Tugas 7-086.png
% // latex: F(x) = 1 - e^{-\lambda x},
% 
% fungsi inversnya adalah
% 
% latex: F^{-1}(\xi) = -\frac{1}{\lambda}\ln(1 - \xi).
% %image% Tugas 7-087.png
% // latex: F^{-1}(\xi) = -\frac{1}{\lambda}\ln(1 - \xi).
>lambda = 2; xi = random(1, 5000);
>eta = -log(1 - xi) / lambda;
>plot2d(eta, distribution=25, style="\/"); ...
>plot2d("2*exp(-2*x)", 0, max(eta), color=red, thickness=2, >add):
 %image% Tugas 7-088.png
% * Aplikasi Metode Monte Carlo dalam Matematika Numerik
% 
% ** 1. Evaluasi Integral Tunggal
% 
% Untuk menghitung integral tentu
% 
% latex: I = \int_0^1 g(x)\,dx
% %image% Tugas 7-089.png
% // latex: I = \int_0^1 g(x)\,dx
% 
% dengan
% 
% latex: 0 \le g(x) \le 1,
% %image% Tugas 7-090.png
% // latex: 0 \le g(x) \le 1,
% 
% terdapat dua pendekatan Monte Carlo:
% 
% (a) Metode Frekuensi Relatif (Hit-or-Miss): Membangkitkan n pasang titik acak
% 
% latex: (\xi_i, \eta_i) \in [0, 1]^2
% %image% Tugas 7-091.png
% // latex: (\xi_i, \eta_i) \in [0, 1]^2
% 
% dan menghitung proporsi titik m/n yang memenuhi
% 
% latex: \eta_i \le g(\xi_i).
% %image% Tugas 7-092.png
% // latex: \eta_i \le g(\xi_i).
% 
% (b) Metode Nilai Rata-Rata: Menghitung rata-rata fungsi pada titik acak seragam
% 
% latex: \xi_i \in [0, 1]
% %image% Tugas 7-093.png
% // latex: \xi_i \in [0, 1]
% 
% latex: \int_0^1 g(x)\,dx \approx \frac{1}{n}\sum_{i=1}^n g(\xi_i).
% %image% Tugas 7-094.png
% // latex: \int_0^1 g(x)\,dx \approx \frac{1}{n}\sum_{i=1}^n g(\xi_i).
% 
% Mari kita bandingkan kedua metode tersebut untuk menghitung
% 
% latex: \int_0^1 \frac{4}{1 + x^2}\,dx = \pi \approx 3.14159265.
% %image% Tugas 7-095.png
% // latex: \int_0^1 \frac{4}{1 + x^2}\,dx = \pi \approx 3.14159265.
% 
% Karena nilai maksimum integran adalah 4, kita menskalakan fungsi dengan
% 
% latex: g(x) = \frac{1}{1+x^2} \in [0, 1]
% %image% Tugas 7-096.png
% // latex: g(x) = \frac{1}{1+x^2} \in [0, 1]
% 
% lalu mengalikan hasilnya dengan 4.
>n = 100000;
>xi = random(1, n); eta = random(1, n);
>g = 1 / (1 + xi^2);
>pihitormiss = 4 * sum(eta <= g) / n
3.1475
>pimeanvalue = 4 * mean(g)
3.1429
% Metode nilai rata-rata umumnya memberikan galat yang lebih kecil dibandingkan metode frekuensi
% relatif untuk jumlah sampel n yang sama.
% 
% ** 2. Evaluasi Integral Lipat Dua
% 
% Untuk menghitung volume
% 
% latex: V = \iint_S h(x, y)\,dx\,dy
% %image% Tugas 7-097.png
% // latex: V = \iint_S h(x, y)\,dx\,dy
% 
% pada domain
% 
% latex: S = [a, b] \times [c, d]
% %image% Tugas 7-098.png
% // latex: S = [a, b] \times [c, d]
% 
% dengan 
% 
% latex: 0 \le h(x, y) \le e, 
% %image% Tugas 7-099.png
% // latex: 0 \le h(x, y) \le e, 
% 
% kita membangkitkan tripel bilangan acak seragam
% 
% latex: (u_i, v_i, w_i) \in [0, 1]^3
% %image% Tugas 7-100.png
% // latex: (u_i, v_i, w_i) \in [0, 1]^3
% 
% dan menghitung proporsi titik di bawah permukaan h(x, y).
% 
% Sebagai contoh, kita hitung
% 
% latex: V = \int_0^1 \int_0^1 (x^2 + y^2)\,dx\,dy = \frac{2}{3}
% %image% Tugas 7-101.png
% // latex: V = \int_0^1 \int_0^1 (x^2 + y^2)\,dx\,dy = \frac{2}{3}
% 
% (dengan batas atas e = 2).
>n = 200000;
>u = random(1, n); v = random(1, n); w = random(1, n);
>e = 2;
>Vhit = e * sum(w <= (u^2 + v^2) / e) / n
0.66031
>Vmean = mean(u^2 + v^2)
0.66526
% ** 3. Penyelesaian Masalah Nilai Batas Laplace dengan Random Walk
% 
% Metode Monte Carlo dapat digunakan untuk menghampiri solusi persamaan diferensial parsial Laplace
% 
% latex: \Delta u = \frac{\partial^2 u}{\partial x^2} + \frac{\partial^2 u}{\partial y^2} = 0
% %image% Tugas 7-102.png
% // latex: \Delta u = \frac{\partial^2 u}{\partial x^2} + \frac{\partial^2 u}{\partial y^2} = 0
% 
% pada domain G dengan syarat batas u(x, y) = f(x, y) pada \Gamma.
% 
% Domain G didiskretisasi menggunakan kisi persegi dengan langkah h = 1. Sebuah partikel dimulai dari
% titik interior P(x_0, y_0) dan bergerak secara acak ke salah satu dari empat titik tetangganya
% masing-masing dengan probabilitas 1/4 hingga menyentuh titik batas R_i \in \Gamma. Nilai u(x_0, y_0)
% dihampiri oleh rata-rata nilai batas f(R_i) tempat jalan acak berhenti:
% 
% latex: v(x_0, y_0) \approx \frac{1}{n} \sum_{k=1}^n f(R^{(k)}).
% %image% Tugas 7-103.png
% // latex: v(x_0, y_0) \approx \frac{1}{n} \sum_{k=1}^n f(R^{(k)}).
% 
% Kita uji metode ini pada kisi persegi
% 
% latex: 0 \le x \le 4, \quad 0 \le y \le 4
% %image% Tugas 7-104.png
% // latex: 0 \le x \le 4, \quad 0 \le y \le 4
% 
% dengan fungsi batas harmonik f(x, y) = x + 2y. Solusi eksak pada titik interior
% 
% latex: (2, 1) \quad \text{adalah} \quad u(2, 1) = 2 + 2(1) = 4.
% %image% Tugas 7-105.png
% // latex: (2, 1) \quad \text{adalah} \quad u(2, 1) = 2 + 2(1) = 4.
>
>function laplacerw (x0, y0, nwalks)
$  total = 0;
$  for k = 1 to nwalks;
$    x = x0; y = y0;
$    repeat
$      until (x == 0 || x == 4 || y == 0 || y == 4);
$      dir = intrandom(1, 1, 4)[1];
$      if dir == 1 then x = x + 1;
$      elseif dir == 2 then x = x - 1;
$      elseif dir == 3 then y = y + 1;
$      else y = y - 1;
$      endif;
$    end;
$    total = total + (x + 2*y); // evaluasi syarat batas f(x, y) = x + 2y
$  end;
$  return total / nwalks;
$endfunction
>laplacerw(2, 1, 5000)
4.0116
>
