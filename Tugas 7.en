% Jelas terlihat bahwa usia ayah dan ibu saling bergantung satu sama lain. Mari kita tentukan dan plot
% garis regresinya.
>cs:=MS[,4:5]'; ps:=polyfit(cs[1],cs[2],1)
[17.3789,  0.740964]
% Model ini jelas keliru. Garis regresinya akan menjadi s=17+0.74t, di mana t adalah usia ibu dan s
% adalah usia ayah. Perbedaan usia mungkin sedikit bergantung pada usia, tetapi tidak sebanyak itu.
% 
% Sebaliknya, kita menduga fungsi seperti s=a+t. Maka a adalah rata-rata dari s-t. Nilai ini merupakan
% rata-rata selisih usia antara ayah dan ibu.
>da:=mean(cs[2]-cs[1])
3.65
% Mari kita plot ini ke dalam satu plot pencar.
>plot2d(cs[1],cs[2],>points);  ...
>plot2d("evalpoly(x,ps)",color=red,style=".",>add);  ...
>plot2d("x+da",color=blue,>add):
 %image% Tugas 7-038.png
% Berikut adalah plot kotak dari kedua usia tersebut. Ini hanya menunjukkan bahwa usia keduanya
% berbeda.
>boxplot(cs,["mothers","fathers"]):
 %image% Tugas 7-039.png
% Menarik untuk dicatat bahwa selisih mediannya tidak sebesar selisih rata-ratanya.
>median(cs[2])-median(cs[1])
1.5
% Koefisien korelasi menunjukkan adanya korelasi positif.
>correl(cs[1],cs[2])
0.7588307236
% Korelasi peringkat (rank correlation) adalah ukuran untuk urutan yang sama pada kedua vektor.
% Nilainya juga cukup positif.
>rankcorrel(cs[1],cs[2])
0.758925292358
% * Membuat Fungsi Baru
% 
% Tentu saja, bahasa EMT dapat digunakan untuk memprogram fungsi-fungsi baru. Misalnya, kita
% mendefinisikan fungsi kemencengan (skewness).
% 
% latex: \text{sk}(x) = \dfrac{\sqrt{n} \sum_i (x_i-m)^3}{\left(\sum_i (x_i-m)^2\right)^{3/2}}
% %image% Tugas 7-040.png
% // latex: \text{sk}(x) = \dfrac{\sqrt{n} \sum_i (x_i-m)^3}{\left(\sum_i (x_i-m)^2\right)^{3/2}}
% 
% di mana m adalah rata-rata dari x.
>function skew (x:vector) ...
$m=mean(x);
$return sqrt(cols(x))*sum((x-m)^3)/(sum((x-m)^2))^(3/2);
$endfunction
% Seperti yang Anda lihat, kita dapat dengan mudah menggunakan bahasa matriks untuk mendapatkan
% implementasi yang sangat singkat dan efisien. Mari kita coba fungsi ini.
>data=normal(20); skew(normal(10))
-0.198710316203
% Berikut adalah fungsi lain, yang disebut koefisien kemencengan Pearson.
>function skew1 (x) := 3*(mean(x)-median(x))/dev(x)
>skew1(data)
-0.0801873249135
% * Simulasi Monte Carlo
% 
% Euler dapat digunakan untuk mensimulasikan kejadian acak. Kita telah melihat contoh sederhana di
% atas. Berikut adalah contoh lainnya, yang mensimulasikan 1000 kali lemparan 3 dadu, dan mencari
% distribusi dari jumlah mata dadunya.
>ds:=sum(intrandom(1000,3,6))';  fs=getmultiplicities(3:18,ds)
[5,  17,  35,  44,  75,  97,  114,  116,  143,  116,  104,  53,  40,  22,  13,  6]
% Kita dapat memplotnya sekarang.
>columnsplot(fs,lab=3:18):
 %image% Tugas 7-041.png
% Menentukan distribusi yang diharapkan tidaklah begitu mudah. Kita menggunakan rekursi tingkat lanjut
% untuk ini.
% 
% Fungsi berikut menghitung banyaknya cara angka k dapat direpresentasikan sebagai penjumlahan dari n
% bilangan dalam rentang 1 hingga m. Fungsi ini bekerja secara rekursif dengan cara yang jelas.
>function map countways (k; n, m) ...
$  if n==1 then return k>=1 && k<=m
$  else
$    sum=0; 
$    loop 1 to m; sum=sum+countways(k-#,n-1,m); end;
$    return sum;
$  end;
$endfunction
% Berikut adalah hasil untuk tiga lemparan dadu.
>countways(5:25,5,5)
[1,  5,  15,  35,  70,  121,  185,  255,  320,  365,  381,  365,  320,  255,  185,  121,  70,  35,
15,  5,  1]
>cw=countways(3:18,3,6)
[1,  3,  6,  10,  15,  21,  25,  27,  27,  25,  21,  15,  10,  6,  3,  1]
% Kita menambahkan nilai harapan ke dalam plot.
>plot2d(cw/6^3*1000,>add); plot2d(cw/6^3*1000,>points,>add):
 %image% Tugas 7-042.png
% Untuk simulasi lain, simpangan nilai rata-rata dari n variabel acak berdistribusi normal 0-1 adalah
% 1/sqrt(n).
>longformat; 1/sqrt(10)
0.316227766017
% Mari kita periksa hal ini dengan simulasi. Kita menghasilkan 10000 kali 10 vektor acak.
>M=normal(10000,10); dev(mean(M)')
0.319493614817
>plot2d(mean(M)',>distribution):
 %image% Tugas 7-043.png
% Median dari 10 bilangan acak berdistribusi normal 0-1 memiliki simpangan yang lebih besar.
>dev(median(M)')
0.374460271535
% Karena kita dapat dengan mudah menghasilkan jalan acak (random walk), kita dapat mensimulasikan
% proses Wiener. Kita mengambil 1000 langkah dari 1000 proses. Kemudian kita memplot simpangan baku dan
% rata-rata dari langkah ke-n proses-proses ini bersama dengan nilai harapannya dalam warna merah.
>n=1000; m=1000; M=cumsum(normal(n,m)/sqrt(m)); ...
>t=(1:n)/n; figure(2,1); ...
>figure(1); plot2d(t,mean(M')'); plot2d(t,0,color=red,>add); ...
>figure(2); plot2d(t,dev(M')'); plot2d(t,sqrt(t),color=red,>add); ...
>figure(0):
 %image% Tugas 7-044.png
% * Pengujian (Uji Statistik)
% 
% Pengujian adalah alat penting dalam statistika. Di Euler, banyak uji yang telah diimplementasikan.
% Semua uji ini mengembalikan galat (p-value) yang kita terima jika kita menolak hipotesis nol.
% 
% Sebagai contoh, kita menguji lemparan dadu untuk distribusi seragam. Pada 600 lemparan, kita
% mendapatkan nilai-nilai berikut, yang kita masukkan ke dalam uji chi-kuadrat.
>chitest([90,103,114,101,103,89],dup(100,6)')
0.498830517952
% Uji chi-kuadrat juga memiliki mode yang menggunakan simulasi Monte Carlo untuk menguji statistik.
% Hasilnya seharusnya hampir sama. Parameter >p menafsirkan vektor y sebagai vektor probabilitas.
>chitest([90,103,114,101,103,89],dup(1/6,6)',>p,>montecarlo)
0.526
% Galat ini jauh terlalu besar. Jadi kita tidak dapat menolak distribusi seragam. Hal ini tidak
% membuktikan bahwa dadu kita adil, tetapi kita tidak dapat menolak hipotesis kita.
% 
% Selanjutnya kita membangkitkan 1000 lemparan dadu menggunakan pembangkit bilangan acak, dan melakukan
% pengujian yang sama.
>n=1000; t=random([1,n*6]); chitest(count(t*6,6),dup(n,6)')
0.528028118442
% Mari kita uji nilai rata-rata 100 dengan uji-t (t-test).
>s=200+normal([1,100])*10; ...
>ttest(mean(s),dev(s),100,200)
0.0218365848476
% Fungsi ttest() memerlukan nilai rata-rata, simpangan, jumlah data, dan nilai rata-rata yang akan
% diuji.
% 
% Sekarang mari kita periksa dua pengukuran untuk rata-rata yang sama. Kita menolak hipotesis bahwa
% keduanya memiliki rata-rata yang sama jika hasilnya <0.05.
>tcomparedata(normal(1,10),normal(1,10))
0.38722000942
% Jika kita menambahkan bias pada salah satu distribusi, kita mendapatkan lebih banyak penolakan.
% Ulangi simulasi ini beberapa kali untuk melihat efeknya.
>tcomparedata(normal(1,10),normal(1,10)+2)
5.60009101758e-07
% Pada contoh berikutnya, kita membangkitkan 20 lemparan dadu acak sebanyak 100 kali dan menghitung
% kemunculan angka satu di dalamnya. Rata-ratanya haruslah 20/6=3.3 angka satu.
>R=random(100,20); R=sum(R*6<=1)'; mean(R)
3.28
% Sekarang kita membandingkan jumlah angka satu tersebut dengan distribusi binomial. Pertama kita
% memplot distribusi angka satu.
>plot2d(R,distribution=max(R)+1,even=1,style="\/"):
 %image% Tugas 7-045.png
>t=count(R,21);
% Kemudian kita menghitung nilai harapannya.
