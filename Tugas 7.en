% * EMT untuk Statistika
% 
% Pada notebook ini, kami mendemonstrasikan plot, uji, dan distribusi statistika utama di Euler.
% 
% Mari kita mulai dengan beberapa statistika deskriptif. Ini bukan pengantar statistika. Jadi Anda
% mungkin memerlukan beberapa latar belakang untuk memahami detailnya.
% 
% Misalkan terdapat pengukuran berikut. Kita ingin menghitung nilai rata-rata (mean) dan simpangan baku
% (standar deviasi) yang terukur.
>M=[1000,1004,998,997,1002,1001,998,1004,998,997]; ...
>median(M), mean(M), dev(M)
999
999.9
2.72641400622
>a&=max(M)-min(M); $a // range M
 %image% Tugas 7-001.png
% // latex: 0
% Kita dapat membuat plot box-and-whiskers (boxplot) untuk data tersebut. Dalam kasus kita, tidak ada
% pencilan (outlier).
>aspect(1.75); boxplot(M):
 %image% Tugas 7-002.png
% Kita menghitung probabilitas bahwa suatu nilai lebih besar dari 1005, dengan mengasumsikan
% nilai-nilai yang diukur berasal dari distribusi normal.
% 
% Semua fungsi untuk distribusi di Euler diakhiri dengan ...dis dan menghitung fungsi distribusi
% probabilitas kumulatif (CPF).
% 
% latex: \text{normaldis(x,m,d)}=\int_{-\infty}^x \frac{1}{d\sqrt{2\pi}}e^{-\frac{1}{2}(\frac{t-m}{d})^2}\ dt.
% %image% Tugas 7-003.png
% // latex: \text{normaldis(x,m,d)}=\int_{-\infty}^x \frac{1}{d\sqrt{2\pi}}e^{-\frac{1}{2}(\frac{t-m}{d})^2}\ dt.
% 
% Kita mencetak hasilnya dalam % dengan ketelitian 2 digit menggunakan fungsi print.
>print((1-normaldis(1005,mean(M),dev(M)))*100,2,unit=" %")
      3.07 %
% Untuk contoh berikutnya, kita mengasumsikan jumlah pria berikut dalam rentang ukuran tertentu.
>r=155.5:4:187.5; v=[22,71,136,169,139,71,32,8];
% Berikut adalah plot dari distribusi tersebut.
>plot2d(r,v,a=150,b=200,c=0,d=190,bar=1,style="\/"):
 %image% Tugas 7-004.png
% Kita dapat memasukkan data mentah tersebut ke dalam sebuah tabel.
% 
% Tabel adalah metode untuk menyimpan data statistika. Tabel kita harus berisi tiga kolom: Awal
% rentang, akhir rentang, dan jumlah pria dalam rentang tersebut.
% 
% Tabel dapat dicetak dengan judul kolom (header). Kita menggunakan vektor string untuk mengatur judul
% kolomnya.
>T:=r[1:8]' | r[2:9]' | v'; writetable(T,labc=["BB","BA","Frek"])
        BB        BA      Frek
     155.5     159.5        22
     159.5     163.5        71
     163.5     167.5       136
     167.5     171.5       169
     171.5     175.5       139
     175.5     179.5        71
     179.5     183.5        32
     183.5     187.5         8
% Jika kita memerlukan nilai rata-rata dan statistik lainnya dari ukuran tersebut, kita perlu
% menghitung titik tengah dari rentang-rentang tersebut. Kita dapat menggunakan dua kolom pertama dari
% tabel kita untuk ini.
% 
% Simbol "|" digunakan untuk memisahkan kolom, fungsi "writetable" digunakan untuk menulis tabel,
% dengan opsi "labc" untuk menentukan judul kolom.
>(T[,1]+T[,2])/2 // titik tengah setiap interval
        157.5 
        161.5 
        165.5 
        169.5 
        173.5 
        177.5 
        181.5 
        185.5 
% Namun, lebih mudah untuk melipat (fold) rentang tersebut dengan vektor [1/2,1/2].
>M=fold(r,[0.5,0.5])
[157.5,  161.5,  165.5,  169.5,  173.5,  177.5,  181.5,  185.5]
% Sekarang kita dapat menghitung rata-rata dan simpangan dari sampel dengan frekuensi yang diberikan.
>{m,d}=meandev(M,v); m, d,
169.901234568
5.98912964449
% Mari kita tambahkan distribusi normal dari nilai-nilai tersebut ke plot batang di atas. Rumus
% distribusi normal dengan rata-rata m dan simpangan baku d adalah:
% 
% latex: y=\frac{1}{d\sqrt{2\pi}}e^{\frac{-(x-m)^2}{2d^2}}.
% %image% Tugas 7-005.png
% // latex: y=\frac{1}{d\sqrt{2\pi}}e^{\frac{-(x-m)^2}{2d^2}}.
% 
% Karena nilainya berada di antara 0 dan 1, untuk memplotnya pada plot batang, nilainya harus dikalikan
% dengan 4 kali jumlah total data.
>
>plot2d("qnormal(x,m,d)*sum(v)*4", ...
>  xmin=min(r),xmax=max(r),thickness=3,add=1):
 %image% Tugas 7-006.png
% * Tabel
% 
% Di dalam direktori notebook ini Anda akan menemukan sebuah file berisi tabel. Data tersebut
% merepresentasikan hasil survei. Berikut adalah empat baris pertama dari file tersebut. Data ini
% berasal dari buku daring berbahasa Jerman "EinfÃ¼hrung in die Statistik mit R" karya A. Handl.
>printfile("table.dat",4);
Person Sex Age Titanic Evaluation Tip Problem
1 m 30 n . 1.80 n
2 f 23 y g 1.80 n
3 f 26 y g 1.80 y
% Tabel ini berisi 7 kolom angka atau token (string). Kita ingin membaca tabel dari file tersebut.
% Pertama, kita menggunakan terjemahan kita sendiri untuk token-token tersebut.
% 
% Untuk itu, kita mendefinisikan himpunan token. Fungsi strtokens() mengambil vektor string token dari
% string yang diberikan.
>mf:=["m","f"]; yn:=["y","n"]; ev:=strtokens("g vg m b vb");
% Sekarang kita membaca tabel dengan terjemahan ini.
% 
% Argumen tok2, tok4, dll. adalah terjemahan dari kolom-kolom tabel. Argumen-argumen ini tidak ada
% dalam daftar parameter readtable(), sehingga Anda perlu memberikannya dengan ":=".
>{MT,hd}=readtable("table.dat",tok2:=mf,tok4:=yn,tok5:=ev,tok7:=yn);
>load over statistics;
% Untuk pencetakan, kita perlu menentukan himpunan token yang sama. Kita hanya mencetak empat baris
% pertama.
>writetable(MT[1:10],labc=hd,wc=5,tok2:=mf,tok4:=yn,tok5:=ev,tok7:=yn);
 Person  Sex  Age Titanic Evaluation  Tip Problem
      1    m   30       n          .  1.8       n
